APP_NAME=IZ Clinical Notes Analyzer
ENVIRONMENT=local-client
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local desktop default: embedded SQLite, no Docker and no PostgreSQL required.
DATABASE_BACKEND=sqlite
LOCAL_SQLITE_DB_PATH=clinical-notes-analyzer.sqlite3
DATABASE_URL=

# Optional developer/server PostgreSQL settings. Leave these unused for the packaged Windows app.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=iz_clinical_notes_analyzer
DATABASE_USER=iz_clinical_notes_app
DATABASE_PASSWORD=change-me-app
POSTGRES_SERVICE_HOST=postgres

SECRET_KEY=change-me
DATA_ENCRYPTION_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
UPLOAD_DIR=uploads
LOG_DIR=logs
RULES_CONFIG_PATH=config/rules/alleva_treatment_plan_completeness_rules.yaml
MAX_UPLOAD_FILE_BYTES=52428800
MAX_UPLOAD_TOTAL_BYTES=262144000
MAX_UPLOAD_FILE_COUNT=40
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
RESET_BOOTSTRAP_ADMIN_ON_STARTUP=true

# Optional future integrations; v1 completeness checks do not require an LLM.
LLM_ENABLED=false
EMR_API_ENABLED=false
