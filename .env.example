COMPOSE_PROJECT_NAME=iz_clinical_notes_analyzer
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=iz_clinical_notes_analyzer_postgres_data
BACKEND_DATA_VOLUME_NAME=iz_clinical_notes_analyzer_backend_data
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=iz_clinical_notes_analyzer
DATABASE_USER=iz_clinical_notes_app
DATABASE_PASSWORD=change-me-app
POSTGRES_SERVICE_HOST=postgres
SECRET_KEY=change-me
DATA_ENCRYPTION_KEY=change-me
# Optional explicit override. When omitted, the backend builds its own DSN from DATABASE_*.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,::1
UPLOAD_DIR=uploads
LOG_DIR=logs
MAX_UPLOAD_FILE_BYTES=52428800
MAX_UPLOAD_TOTAL_BYTES=262144000
MAX_UPLOAD_FILE_COUNT=40
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
RESET_BOOTSTRAP_ADMIN_ON_STARTUP=true
